<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Kikitori.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="StateListeningBrush" Color="#0F7B0F" />
                    <SolidColorBrush x:Key="StateBusyBrush" Color="#005FB8" />
                    <SolidColorBrush x:Key="StatePausedBrush" Color="#9D5D00" />
                    <SolidColorBrush x:Key="StateIdleBrush" Color="#5F5F5F" />
                    <SolidColorBrush x:Key="StateErrorBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="StateIconBackgroundBrush" Color="#0A000000" />
                    <SolidColorBrush x:Key="PartialTextBrush" Color="#2B6CD8" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="StateListeningBrush" Color="#6CCB5F" />
                    <SolidColorBrush x:Key="StateBusyBrush" Color="#60CDFF" />
                    <SolidColorBrush x:Key="StatePausedBrush" Color="#FCE100" />
                    <SolidColorBrush x:Key="StateIdleBrush" Color="#C5C5C5" />
                    <SolidColorBrush x:Key="StateErrorBrush" Color="#FF99A4" />
                    <SolidColorBrush x:Key="StateIconBackgroundBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="PartialTextBrush" Color="#7FB0FF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="StateListeningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="StateBusyBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="StatePausedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="StateIdleBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="StateErrorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="StateIconBackgroundBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="PartialTextBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Win11 设置页风格 -->
            <x:Double x:Key="SettingsCardSpacing">4</x:Double>
            <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,20" />
            </Style>
            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="1,26,0,8" />
            </Style>
            <Style x:Key="PageScrollerStyle" TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <!-- 两个都要设：否则内容按“无限宽”测量，比视口窄时会被 ScrollViewer 居中而错位 -->
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="HorizontalScrollMode" Value="Disabled" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
