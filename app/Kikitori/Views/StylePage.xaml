<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Kikitori.Views.StylePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kikitori.Controls"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Required">

    <ScrollViewer Style="{StaticResource PageScrollerStyle}">
        <controls:PageColumn><StackPanel Padding="36,20,36,36">
            <TextBlock Text="字幕样式" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Margin="2,-12,0,16" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="改动会立刻作用到屏幕上的字幕条。这些设置也可以在字幕条上右键修改。" />

            <TextBlock Text="文字" Style="{StaticResource SectionHeaderStyle}" Margin="1,0,0,8" />
            <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                <tk:SettingsCard Header="译文字号" Description="大字（翻译结果）">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8E9;" /></tk:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Name="FontText" Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Slider x:Name="FontSlider" Width="240" Minimum="12" Maximum="48" StepFrequency="1" ValueChanged="Slider_ValueChanged" />
                    </StackPanel>
                </tk:SettingsCard>
                <tk:SettingsCard Header="原文字号" Description="小字（主播说的原文）">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8E8;" /></tk:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Name="SourceFontText" Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Slider x:Name="SourceFontSlider" Width="240" Minimum="8" Maximum="32" StepFrequency="1" ValueChanged="Slider_ValueChanged" />
                    </StackPanel>
                </tk:SettingsCard>
                <tk:SettingsCard Header="显示原文" Description="关掉后只显示译文（草稿也不显示）">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8C1;" /></tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="ShowSourceToggle" Toggled="Toggle_Toggled" />
                </tk:SettingsCard>
                <tk:SettingsCard Header="字幕居中" Description="关掉 = 左对齐">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8E3;" /></tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="CenterToggle" Toggled="Toggle_Toggled" />
                </tk:SettingsCard>
                <tk:SettingsCard Header="文字阴影" Description="在亮色或复杂视频背景下保持字幕清晰锐利">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE790;" /></tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="TextShadowToggle" Toggled="Toggle_Toggled" />
                </tk:SettingsCard>
                <tk:SettingsCard Header="显示条数" Description="字幕条上同时显示最近几句（最新的在最下面）">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8FD;" /></tk:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Name="LinesText" Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Slider x:Name="LinesSlider" Width="240" Minimum="1" Maximum="6" StepFrequency="1" TickFrequency="1"
                                TickPlacement="Outside" SnapsTo="StepValues" ValueChanged="Slider_ValueChanged" />
                    </StackPanel>
                </tk:SettingsCard>
            </StackPanel>

            <TextBlock Text="窗口" Style="{StaticResource SectionHeaderStyle}" />
            <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                <tk:SettingsCard Header="背景不透明度" Description="只影响深色背景，文字始终清晰不透明">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE706;" /></tk:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Name="OpacityText" Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Slider x:Name="OpacitySlider" Width="240" Minimum="30" Maximum="100" StepFrequency="5" ValueChanged="Slider_ValueChanged" />
                    </StackPanel>
                </tk:SettingsCard>
                <tk:SettingsCard Header="窗口宽度" Description="也可以拖动字幕条右下角调整；高度会随字幕内容自动伸缩">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE740;" /></tk:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Name="WidthText" Width="72" TextAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Slider x:Name="WidthSlider" Width="240" Minimum="320" Maximum="2560" StepFrequency="10" ValueChanged="Slider_ValueChanged" />
                    </StackPanel>
                </tk:SettingsCard>
                <tk:SettingsCard Header="显示字幕条" Description="也可以在托盘图标上右键切换">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xED1E;" /></tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="VisibleToggle" Toggled="VisibleToggle_Toggled" />
                </tk:SettingsCard>
                <tk:SettingsCard Header="重置字幕条位置" Description="字幕条找不到了？放回主屏幕底部中间，并恢复默认宽度">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7A7;" /></tk:SettingsCard.HeaderIcon>
                    <Button x:Name="ResetButton" Content="重置位置" Click="Reset_Click" MinWidth="110" />
                </tk:SettingsCard>
                <tk:SettingsCard Header="恢复默认样式" Description="字号、条数、不透明度、对齐方式恢复成默认值">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE777;" /></tk:SettingsCard.HeaderIcon>
                    <Button x:Name="DefaultsButton" Content="恢复默认" Click="Defaults_Click" MinWidth="110" />
                </tk:SettingsCard>
            </StackPanel>
        </StackPanel></controls:PageColumn>
    </ScrollViewer>
</Page>
