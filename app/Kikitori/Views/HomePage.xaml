<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Kikitori.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kikitori.Controls"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:models="using:Kikitori.Models"
    NavigationCacheMode="Required">

    <ScrollViewer Style="{StaticResource PageScrollerStyle}">
        <controls:PageColumn><StackPanel Padding="36,20,36,36">
            <TextBlock Text="首页" Style="{StaticResource PageTitleStyle}" />

            <!-- 首次使用引导：翻译还没配置好时常驻，填好后自动消失 -->
            <InfoBar x:Name="SetupBar" Severity="Warning" IsClosable="False" IsOpen="False" Margin="0,0,0,16"
                     Title="翻译还没有设置好">
                <InfoBar.ActionButton>
                    <Button x:Name="GoSetupButton" Content="去填写" Click="GoSetup_Click" Style="{StaticResource AccentButtonStyle}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- ================= 状态卡片 ================= -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="20,18">
                <Grid ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="StateIconHost" Width="52" Height="52" CornerRadius="26"
                          Background="{ThemeResource StateIconBackgroundBrush}" VerticalAlignment="Center">
                        <FontIcon x:Name="StateIcon" Glyph="&#xE720;" FontSize="22" />
                        <ProgressRing x:Name="StateRing" Width="52" Height="52" IsActive="False" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="StateTitle" Text="正在启动" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="StateMessage" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" MaxLines="3"
                                   TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ProgressBar x:Name="DownloadBar" Visibility="Collapsed" Maximum="1" Margin="0,8,0,0" />
                    </StackPanel>

                    <Button x:Name="StartStopButton" Grid.Column="2" MinWidth="150" Height="46" Padding="20,0"
                            VerticalAlignment="Center" Click="StartStop_Click" Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon x:Name="StartStopIcon" Glyph="&#xE768;" FontSize="16" />
                            <TextBlock x:Name="StartStopText" Text="开始监听" FontSize="15" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- 音量电平 + 暂停 -->
                    <Grid Grid.Row="1" Grid.ColumnSpan="3" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE767;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  ToolTipService.ToolTip="音量：有没有听到声音" />
                        <ProgressBar x:Name="LevelBar" Grid.Column="1" Maximum="1" MinHeight="6" VerticalAlignment="Center" />
                        <TextBlock x:Name="LevelText" Grid.Column="2" Width="72" VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <ToggleSwitch x:Name="PauseToggle" Grid.Column="3" MinWidth="0" OnContent="已暂停" OffContent="暂停识别"
                                      Toggled="PauseToggle_Toggled" />
                    </Grid>
                </Grid>
            </Border>

            <!-- ================= 语言与音频 ================= -->
            <TextBlock Text="语言与音频" Style="{StaticResource SectionHeaderStyle}" />
            <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                <tk:SettingsCard Header="说话语言" Description="主播说的语言。也可以在字幕条上右键切换">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE720;" /></tk:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="SourceCombo" MinWidth="200" SelectionChanged="Language_SelectionChanged" />
                </tk:SettingsCard>
                <tk:SettingsCard Header="翻译成" Description="字幕大字显示的语言">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xF2B7;" /></tk:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="TargetCombo" MinWidth="200" SelectionChanged="Language_SelectionChanged" />
                </tk:SettingsCard>
                <tk:SettingsCard Header="音频设备" Description="录制哪个设备正在播放的声音（就是你耳机/音箱里听到的）">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7F5;" /></tk:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="DeviceCombo" MinWidth="240" MaxWidth="340" SelectionChanged="DeviceCombo_SelectionChanged" />
                        <Button x:Name="RefreshDevicesButton" Click="RefreshDevices_Click" ToolTipService.ToolTip="刷新设备列表" Height="32">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                        <Button x:Name="ReconnectButton" Content="重新连接" Click="Reconnect_Click"
                                ToolTipService.ToolTip="换了耳机/音箱、或者没有声音时点这里" />
                    </StackPanel>
                </tk:SettingsCard>
                <tk:SettingsCard Header="显示字幕条" Description="屏幕上的悬浮字幕窗口（左键拖动，右键菜单）">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xED1E;" /></tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="OverlayToggle" Toggled="OverlayToggle_Toggled" />
                </tk:SettingsCard>
                <tk:SettingsCard Header="启动后自动开始监听" Description="打开程序就开始识别，不用再点「开始监听」">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7E8;" /></tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="AutoStartToggle" Toggled="AutoStartToggle_Toggled" />
                </tk:SettingsCard>
            </StackPanel>

            <!-- ================= 实时字幕 ================= -->
            <Grid Margin="1,26,0,8">
                <TextBlock Text="实时字幕" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ClearButton" Click="Clear_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE894;" FontSize="14" />
                            <TextBlock Text="清空" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="OpenRecordsButton" Click="OpenRecords_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE838;" FontSize="14" />
                            <TextBlock Text="打开字幕记录文件夹" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <Border Style="{StaticResource CardBorderStyle}" Height="440">
                <Grid>
                    <ListView x:Name="SubtitleList" SelectionMode="None" IsItemClickEnabled="False" Padding="0,6">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="Padding" Value="16,0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SubtitleItem">
                                <Grid Padding="0,9" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind TimeText, Mode=OneWay}" Margin="0,2,0,0"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="{x:Bind PartialText, Mode=OneWay}" Visibility="{x:Bind PartialVisibility, Mode=OneWay}"
                                                   FontFamily="{x:Bind SourceFont, Mode=OneWay}"
                                                   Foreground="{ThemeResource PartialTextBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind SourceText, Mode=OneWay}" Visibility="{x:Bind SourceVisibility, Mode=OneWay}"
                                                   FontFamily="{x:Bind SourceFont, Mode=OneWay}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <TextBlock Text="{x:Bind MainText, Mode=OneWay}" Visibility="{x:Bind MainVisibility, Mode=OneWay}"
                                                   FontFamily="{x:Bind MainFont, Mode=OneWay}"
                                                   FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <TextBlock Text="…" Visibility="{x:Bind PendingVisibility, Mode=OneWay}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="（翻译失败）" Visibility="{x:Bind FailedVisibility, Mode=OneWay}"
                                                   ToolTipService.ToolTip="{x:Bind Error, Mode=OneWay}"
                                                   Foreground="{ThemeResource StateErrorBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" IsHitTestVisible="False">
                        <FontIcon Glyph="&#xE8BD;" FontSize="30" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="还没有字幕。开始监听后，识别和翻译结果会实时显示在这里。"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel></controls:PageColumn>
    </ScrollViewer>
</Page>
