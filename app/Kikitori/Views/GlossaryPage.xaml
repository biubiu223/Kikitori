<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Kikitori.Views.GlossaryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Kikitori.Models"
    NavigationCacheMode="Required">

    <Grid MaxWidth="1064" Padding="36,20,36,36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="专有名词" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Grid.Row="1" Margin="2,-12,0,16" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="主播名字、粉丝名、固定梗等。会同时提示给语音识别（提高识别准确率）和翻译（统一译名）。原文留空的行会被忽略。" />

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- 表头 -->
                <Grid Padding="16,10,16,10" ColumnSpacing="12" BorderThickness="0,0,0,1"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="原文" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Column="1" Text="中文译名" Style="{StaticResource BodyStrongTextBlockStyle}" />
                </Grid>
                <ListView x:Name="GlossaryList" Grid.Row="1" SelectionMode="None" Padding="0,4">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="Padding" Value="16,0,12,0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:GlossaryEntry">
                            <Grid ColumnSpacing="12" Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{x:Bind Source, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="例如：兎田ぺこら" TextChanged="Entry_TextChanged" />
                                <TextBox Grid.Column="1" Text="{x:Bind Target, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="例如：兔田佩克拉" TextChanged="Entry_TextChanged" />
                                <Button Grid.Column="2" Tag="{x:Bind}" Click="Delete_Click" Padding="8"
                                        Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="删除这一行">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="EmptyHint" Grid.Row="1" Margin="0,40" HorizontalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="还没有专有名词。点下面的「添加一行」开始。" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <Button x:Name="AddButton" Click="Add_Click" Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="添加一行" />
                </StackPanel>
            </Button>
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Margin="8,0,0,0"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </StackPanel>
    </Grid>
</Page>
