<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Kikitori.Views.AsrPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kikitori.Controls"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Required">

    <ScrollViewer Style="{StaticResource PageScrollerStyle}">
        <controls:PageColumn><StackPanel Padding="36,20,36,36">
            <TextBlock Text="语音识别" Style="{StaticResource PageTitleStyle}" />

            <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                <tk:SettingsCard Header="识别模型" Description="第一次使用会自动下载（约 1.5–3GB）。换模型后要重新加载，约十几秒">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE945;" /></tk:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="ModelCombo" MinWidth="320" SelectionChanged="Combo_SelectionChanged">
                        <ComboBoxItem Content="large-v3（推荐，最准）" Tag="large-v3" />
                        <ComboBoxItem Content="large-v3-turbo（更快，日语稍差一点）" Tag="large-v3-turbo" />
                        <ComboBoxItem Content="kotoba-whisper v2.0（日语专用，很快）" Tag="kotoba-tech/kotoba-whisper-v2.0-faster" />
                    </ComboBox>
                </tk:SettingsCard>
                <tk:SettingsCard Header="运行设备" Description="有 NVIDIA 显卡选 GPU；用 CPU 会很慢，跟不上直播">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE950;" /></tk:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="DeviceCombo" MinWidth="320" SelectionChanged="Combo_SelectionChanged">
                        <ComboBoxItem Content="GPU（NVIDIA 显卡，推荐）" Tag="cuda" />
                        <ComboBoxItem Content="CPU（很慢）" Tag="cpu" />
                    </ComboBox>
                </tk:SettingsCard>
                <tk:SettingsCard Header="计算精度" Description="显存紧张（比如同时跑本地 Ollama 大模型）时选 int8_float16">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9D9;" /></tk:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="ComputeCombo" MinWidth="320" SelectionChanged="Combo_SelectionChanged">
                        <ComboBoxItem Content="float16（推荐）" Tag="float16" />
                        <ComboBoxItem Content="int8_float16（省显存）" Tag="int8_float16" />
                        <ComboBoxItem Content="int8（CPU 运行时用）" Tag="int8" />
                    </ComboBox>
                </tk:SettingsCard>
                <tk:SettingsCard Header="下载源" Description="显卡运行库（约 1.3GB）和识别模型（约 3GB）首次使用时的下载地址。国内网络建议选自动或国内镜像。">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE896;" /></tk:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="SourceCombo" MinWidth="320" SelectionChanged="Combo_SelectionChanged">
                        <ComboBoxItem Content="自动（推荐，测速选最快的）" Tag="auto" />
                        <ComboBoxItem Content="国外官方（PyPI / Hugging Face）" Tag="official" />
                        <ComboBoxItem Content="国内镜像（清华 / 阿里云 / hf-mirror）" Tag="china" />
                    </ComboBox>
                </tk:SettingsCard>
                <tk:SettingsCard Header="显示草稿" Description="说话过程中先显示原文“草稿”（蓝色，约每秒刷新一次），说完一句再出翻译">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE70F;" /></tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="PartialToggle" Toggled="PartialToggle_Toggled" />
                </tk:SettingsCard>
            </StackPanel>

            <TextBlock Text="断句" Style="{StaticResource SectionHeaderStyle}" />
            <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                <tk:SettingsCard Header="人声灵敏度" Description="越高越不容易把背景音乐当成人声（BGM 很吵时可以调到 0.6）">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE767;" /></tk:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Name="ThresholdText" Width="64" TextAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Slider x:Name="ThresholdSlider" Width="240" Minimum="0.3" Maximum="0.8" StepFrequency="0.05"
                                TickFrequency="0.1" TickPlacement="Outside" ValueChanged="Slider_ValueChanged" />
                    </StackPanel>
                </tk:SettingsCard>
                <tk:SettingsCard Header="断句停顿" Description="停顿多久算一句话说完（调小 = 出字更快，但句子更碎）">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE916;" /></tk:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Name="SilenceText" Width="64" TextAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Slider x:Name="SilenceSlider" Width="240" Minimum="300" Maximum="1000" StepFrequency="50"
                                TickFrequency="100" TickPlacement="Outside" ValueChanged="Slider_ValueChanged" />
                    </StackPanel>
                </tk:SettingsCard>
                <tk:SettingsCard Header="最长一句" Description="一句话最长多少秒就强制切开送去识别（主播一直不停顿时用）">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8C6;" /></tk:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Name="MaxSegText" Width="64" TextAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Slider x:Name="MaxSegSlider" Width="240" Minimum="4" Maximum="15" StepFrequency="0.5"
                                TickFrequency="1" TickPlacement="Outside" ValueChanged="Slider_ValueChanged" />
                    </StackPanel>
                </tk:SettingsCard>
                <tk:SettingsExpander Header="高级" Description="一般不用改">
                    <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE713;" /></tk:SettingsExpander.HeaderIcon>
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard Header="搜索宽度（beam size）" Description="越大越准，但越慢">
                            <NumberBox x:Name="BeamBox" Width="140" Minimum="1" Maximum="10" SmallChange="1"
                                       SpinButtonPlacementMode="Inline" ValueChanged="Number_ValueChanged" />
                        </tk:SettingsCard>
                        <tk:SettingsCard Header="草稿刷新间隔（秒）" Description="说话过程中多久刷新一次草稿">
                            <NumberBox x:Name="PartialIntervalBox" Width="140" Minimum="0.3" Maximum="5" SmallChange="0.1"
                                       SpinButtonPlacementMode="Inline" ValueChanged="Number_ValueChanged" />
                        </tk:SettingsCard>
                        <tk:SettingsCard Header="最短语音（毫秒）" Description="短于这个长度的声音忽略（过滤咳嗽、点击声）">
                            <NumberBox x:Name="MinSpeechBox" Width="140" Minimum="0" Maximum="2000" SmallChange="50" LargeChange="100"
                                       SpinButtonPlacementMode="Inline" ValueChanged="Number_ValueChanged" />
                        </tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>
            </StackPanel>

            <TextBlock Margin="2,16,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       Text="提示：正在监听时修改这里的设置，会自动用新设置重新开始监听。" />
        </StackPanel></controls:PageColumn>
    </ScrollViewer>
</Page>
