<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Kikitori.Views.TranslationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kikitori.Controls"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Required">

    <ScrollViewer Style="{StaticResource PageScrollerStyle}">
        <controls:PageColumn><StackPanel Padding="36,20,36,36">
            <TextBlock Text="翻译" Style="{StaticResource PageTitleStyle}" />

            <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                <tk:SettingsCard Header="翻译引擎" Description="用哪个大模型把识别出的原文翻译成目标语言">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xF2B7;" /></tk:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="ProviderCombo" MinWidth="240" SelectionChanged="ProviderCombo_SelectionChanged">
                        <ComboBoxItem Content="DeepSeek（推荐）" Tag="deepseek" />
                        <ComboBoxItem Content="本地 Ollama（免费离线）" Tag="ollama" />
                        <ComboBoxItem Content="OpenAI 兼容接口" Tag="openai_compatible" />
                        <ComboBoxItem Content="关闭翻译（只显示原文）" Tag="off" />
                    </ComboBox>
                </tk:SettingsCard>
            </StackPanel>

            <!-- ================= DeepSeek ================= -->
            <StackPanel x:Name="DeepSeekPanel" Spacing="{StaticResource SettingsCardSpacing}">
                <TextBlock Text="DeepSeek" Style="{StaticResource SectionHeaderStyle}" />
                <tk:SettingsCard Header="API Key">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8D7;" /></tk:SettingsCard.HeaderIcon>
                    <tk:SettingsCard.Description>
                        <StackPanel Spacing="2">
                            <TextBlock Text="只保存在这台电脑上（用 Windows 账户加密）。" TextWrapping="Wrap" />
                            <HyperlinkButton x:Name="DeepSeekKeyLink" Content="去哪申请 Key？→ platform.deepseek.com" Padding="0" Margin="0,2,0,0"
                                             NavigateUri="https://platform.deepseek.com/api_keys" />
                        </StackPanel>
                    </tk:SettingsCard.Description>
                    <PasswordBox x:Name="DeepSeekKeyBox" Width="300" PlaceholderText="sk-..." PasswordChanged="DeepSeekKeyBox_PasswordChanged" />
                </tk:SettingsCard>
                <tk:SettingsCard Header="模型" Description="同传要的是快：deepseek-flash 一般零点几秒出译文">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE945;" /></tk:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="DeepSeekModelCombo" MinWidth="300" SelectionChanged="DeepSeekModelCombo_SelectionChanged">
                        <ComboBoxItem Content="deepseek-flash（推荐：快、便宜）" Tag="deepseek-flash" />
                        <ComboBoxItem Content="deepseek-v4-pro（会先思考，太慢，不适合同传）" Tag="deepseek-v4-pro" />
                    </ComboBox>
                </tk:SettingsCard>
                <tk:SettingsExpander Header="高级" Description="接口地址和温度，一般不用改">
                    <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE713;" /></tk:SettingsExpander.HeaderIcon>
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard Header="接口地址">
                            <TextBox x:Name="DeepSeekUrlBox" Width="300" TextChanged="Field_TextChanged" />
                        </tk:SettingsCard>
                        <tk:SettingsCard Header="温度" Description="DeepSeek 官方建议翻译任务用 1.3">
                            <NumberBox x:Name="DeepSeekTempBox" Width="140" Minimum="0" Maximum="2" SmallChange="0.1" LargeChange="0.5"
                                       SpinButtonPlacementMode="Inline" ValueChanged="Number_ValueChanged" />
                        </tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>
            </StackPanel>

            <!-- ================= Ollama ================= -->
            <StackPanel x:Name="OllamaPanel" Spacing="{StaticResource SettingsCardSpacing}">
                <TextBlock Text="本地 Ollama" Style="{StaticResource SectionHeaderStyle}" />
                <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="使用前"
                         Message="先安装 Ollama（ollama.com），然后在命令行运行：ollama pull qwen3:8b。显存够的话可以换成 qwen3:14b（更准，但和语音识别一起跑显存会比较紧）。" />
                <tk:SettingsCard Header="接口地址">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE774;" /></tk:SettingsCard.HeaderIcon>
                    <TextBox x:Name="OllamaUrlBox" Width="300" PlaceholderText="http://localhost:11434" TextChanged="Field_TextChanged" />
                </tk:SettingsCard>
                <tk:SettingsCard Header="模型" Description="Ollama 里已下载的模型名">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE945;" /></tk:SettingsCard.HeaderIcon>
                    <TextBox x:Name="OllamaModelBox" Width="300" PlaceholderText="qwen3:8b" TextChanged="Field_TextChanged" />
                </tk:SettingsCard>
                <tk:SettingsCard Header="温度">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9CA;" /></tk:SettingsCard.HeaderIcon>
                    <NumberBox x:Name="OllamaTempBox" Width="140" Minimum="0" Maximum="2" SmallChange="0.1" LargeChange="0.5"
                               SpinButtonPlacementMode="Inline" ValueChanged="Number_ValueChanged" />
                </tk:SettingsCard>
            </StackPanel>

            <!-- ================= OpenAI 兼容 ================= -->
            <StackPanel x:Name="OpenAiPanel" Spacing="{StaticResource SettingsCardSpacing}">
                <TextBlock Text="OpenAI 兼容接口" Style="{StaticResource SectionHeaderStyle}" />
                <tk:SettingsCard Header="接口地址" Description="通义千问、Kimi、OpenAI 等兼容 OpenAI 格式的服务">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE774;" /></tk:SettingsCard.HeaderIcon>
                    <TextBox x:Name="OpenAiUrlBox" Width="320" PlaceholderText="https://dashscope.aliyuncs.com/compatible-mode/v1" TextChanged="Field_TextChanged" />
                </tk:SettingsCard>
                <tk:SettingsCard Header="API Key" Description="只保存在这台电脑上（用 Windows 账户加密）">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8D7;" /></tk:SettingsCard.HeaderIcon>
                    <PasswordBox x:Name="OpenAiKeyBox" Width="320" PasswordChanged="OpenAiKeyBox_PasswordChanged" />
                </tk:SettingsCard>
                <tk:SettingsCard Header="模型">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE945;" /></tk:SettingsCard.HeaderIcon>
                    <TextBox x:Name="OpenAiModelBox" Width="320" PlaceholderText="qwen-plus" TextChanged="Field_TextChanged" />
                </tk:SettingsCard>
                <tk:SettingsCard Header="温度">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9CA;" /></tk:SettingsCard.HeaderIcon>
                    <NumberBox x:Name="OpenAiTempBox" Width="140" Minimum="0" Maximum="2" SmallChange="0.1" LargeChange="0.5"
                               SpinButtonPlacementMode="Inline" ValueChanged="Number_ValueChanged" />
                </tk:SettingsCard>
            </StackPanel>

            <InfoBar x:Name="OffInfo" IsOpen="True" IsClosable="False" Severity="Informational" Margin="0,16,0,0"
                     Title="翻译已关闭" Message="字幕条只显示识别出的原文。" />

            <!-- ================= 通用 ================= -->
            <TextBlock Text="通用" Style="{StaticResource SectionHeaderStyle}" />
            <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                <tk:SettingsCard Header="参考上文句数" Description="翻译时参考前面几句话，让上下文更连贯（0 = 不参考）">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8BD;" /></tk:SettingsCard.HeaderIcon>
                    <NumberBox x:Name="ContextBox" Width="140" Minimum="0" Maximum="10" SmallChange="1" LargeChange="2"
                               SpinButtonPlacementMode="Inline" ValueChanged="Number_ValueChanged" />
                </tk:SettingsCard>
                <tk:SettingsCard x:Name="TestCard" Header="测试连接" Description="用当前设置翻译一句示例，检查 Key、地址和模型能不能用">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9D9;" /></tk:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ProgressRing x:Name="TestRing" Width="20" Height="20" IsActive="False" />
                        <Button x:Name="TestButton" Content="测试连接" Click="Test_Click" MinWidth="110" />
                    </StackPanel>
                </tk:SettingsCard>
                <InfoBar x:Name="TestResultBar" IsClosable="True" />
            </StackPanel>
        </StackPanel></controls:PageColumn>
    </ScrollViewer>
</Page>
