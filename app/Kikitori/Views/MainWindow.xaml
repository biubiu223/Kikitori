<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Kikitori.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="听译 Kikitori">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自定义标题栏（内容延伸到标题栏，Mica 背景） -->
        <Grid x:Name="AppTitleBar" Height="48" Padding="16,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image x:Name="TitleIcon" Width="18" Height="18" />
                <TextBlock Text="听译" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                <TextBlock Text="Kikitori" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            PaneDisplayMode="Left"
            OpenPaneLength="208"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="True"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavHome" Content="首页" Tag="home">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavTranslate" Content="翻译" Tag="translate">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xF2B7;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavAsr" Content="语音识别" Tag="asr">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE720;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavStyle" Content="字幕样式" Tag="style">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8D2;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavGlossary" Content="专有名词" Tag="glossary">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE82D;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="NavAbout" Content="关于" Tag="about">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 全局提示：引擎异常（带“重启引擎”）、引擎临时通知（notice，几秒后自动消失） -->
                <StackPanel x:Name="BarsPanel" MaxWidth="1064" Padding="36,0,36,0" Spacing="8">
                    <InfoBar x:Name="EngineBar" Severity="Error" IsClosable="False" Margin="0,16,0,0">
                        <InfoBar.ActionButton>
                            <Button x:Name="RestartEngineButton" Content="重启引擎" Click="RestartEngine_Click"
                                    Style="{StaticResource AccentButtonStyle}" />
                        </InfoBar.ActionButton>
                        <StackPanel Spacing="6" Margin="0,0,0,14">
                            <TextBlock x:Name="EngineTailText" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"
                                       TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <HyperlinkButton Content="打开日志文件夹" Padding="0" Click="OpenLogs_Click" />
                        </StackPanel>
                    </InfoBar>
                    <InfoBar x:Name="NoticeBar" IsClosable="True" Margin="0,16,0,0" />
                </StackPanel>

                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
