# ---------- Python ----------
# 虚拟环境放在仓库根目录（engine\ 下的代码和 tools\ 都用它）
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# ---------- 构建产物（体积很大，通过 GitHub Releases 发布，不进仓库）----------
build/
dist/
*.zip
*.7z

# ---------- .NET / WinUI 3 ----------
app/**/bin/
app/**/obj/
.vs/
*.user
*.suo
*.binlog

# ---------- 测试 ----------
# 测试录音由 tools/make_test_audio.ps1 用 Windows 自带语音现场生成，不提交
tools/testdata/*.wav
# 日志（例如 tools/mock_llm.py 默认的请求记录 tools/mock_llm_requests.log）
*.log

# ---------- 系统 / 编辑器 ----------
Thumbs.db
Desktop.ini
.DS_Store
.idea/
.vscode/
